STEP 4 — User.js

Create:

backend/models/User.js

Code:

const mongoose = require("mongoose");

const userSchema = new mongoose.Schema(
  {
    name: {
      type: String,
      required: true,
    },

    email: {
      type: String,
      required: true,
      unique: true,
    },

    password: {
      type: String,
      required: true,
    },
  },
  {
    timestamps: true,
  }
);

const User = mongoose.model("User", userSchema);

module.exports = User;
Line-by-line simple explanation
const mongoose = require("mongoose");

English: Import Mongoose.

Tamil: MongoDB-யுடன் work செய்ய Mongoose import செய்கிறோம்.

const userSchema = new mongoose.Schema(

English: Creates the structure of user data.

Tamil: User data எப்படி இருக்க வேண்டும் என்று structure create செய்கிறது.

name: {
  type: String,
  required: true
}

English: Name must be text and required.

Tamil: Name compulsory; text ஆக இருக்க வேண்டும்.

email: {
  type: String,
  required: true,
  unique: true
}

English: Email is required and cannot be duplicated.

Tamil: Email compulsory; same email மீண்டும் register செய்ய முடியாது.

password

English: Stores the hashed password.

Tamil: Password direct-ஆ store பண்ணாமல் hashed password store பண்ணுவோம்.

mongoose.model("User", userSchema)

English: Creates User model.

Tamil: MongoDB-ல் User collection-ஐ handle செய்ய model உருவாக்குகிறது.

STEP 5 — authRoutes.js

Create:

backend/routes/authRoutes.js

Full code:

const express = require("express");
const bcrypt = require("bcryptjs");
const User = require("../models/User");

const router = express.Router();


// ================= REGISTER =================

router.post("/register", async (req, res) => {
  try {

    const { name, email, password } = req.body;

    // Check fields
    if (!name || !email || !password) {
      return res.status(400).json({
        message: "All fields are required",
      });
    }

    // Check existing user
    const existingUser = await User.findOne({ email });

    if (existingUser) {
      return res.status(400).json({
        message: "Email already registered",
      });
    }

    // Hash password
    const hashedPassword = await bcrypt.hash(password, 10);

    // Create user
    const newUser = new User({
      name,
      email,
      password: hashedPassword,
    });

    // Save user
    await newUser.save();

    res.status(201).json({
      message: "Registration successful",
    });

  } catch (error) {

    console.log(error);

    res.status(500).json({
      message: "Server error",
    });

  }
});


// ================= LOGIN =================

router.post("/login", async (req, res) => {
  try {

    const { email, password } = req.body;

    // Check fields
    if (!email || !password) {
      return res.status(400).json({
        message: "Email and password are required",
      });
    }

    // Find user
    const user = await User.findOne({ email });

    if (!user) {
      return res.status(401).json({
        message: "Invalid email or password",
      });
    }

    // Compare password
    const passwordMatch = await bcrypt.compare(
      password,
      user.password
    );

    if (!passwordMatch) {
      return res.status(401).json({
        message: "Invalid email or password",
      });
    }

    // Login successful
    res.status(200).json({
      message: "Login successful",

      user: {
        id: user._id,
        name: user.name,
        email: user.email,
      },
    });

  } catch (error) {

    console.log(error);

    res.status(500).json({
      message: "Server error",
    });

  }
});


module.exports = router;
authRoutes important explanation
Register
router.post("/register", ...)

English: Handles register API.

Tamil: Register request-ஐ handle செய்கிறது.

Actual URL:

http://localhost:5000/api/auth/register
const { name, email, password } = req.body;

English: Gets data sent from frontend.

Tamil: Frontend அனுப்பிய name, email, password-ஐ பெறுகிறது.

User.findOne({ email })

English: Checks whether email already exists.

Tamil: அந்த email MongoDB-ல் already இருக்கிறதா என்று check செய்கிறது.

bcrypt.hash(password, 10)

English: Converts password into a secure hash.

Tamil: Password-ஐ secure hash ஆக மாற்றுகிறது.

newUser.save()

English: Saves user into MongoDB.

Tamil: User data MongoDB-ல் save ஆகிறது.

STEP 6 — server.js

Create:

backend/server.js

Full code:

const express = require("express");
const mongoose = require("mongoose");
const cors = require("cors");
const dotenv = require("dotenv");

const authRoutes = require("./routes/authRoutes");

dotenv.config();

const app = express();


// Middleware
app.use(cors());

app.use(express.json());


// Routes
app.use("/api/auth", authRoutes);


// Test API
app.get("/", (req, res) => {
  res.send("Backend server is running");
});


// MongoDB connection
mongoose
  .connect(process.env.MONGO_URI)
  .then(() => {

    console.log("MongoDB connected");

    app.listen(process.env.PORT, () => {
      console.log(
        `Server running on http://localhost:${process.env.PORT}`
      );
    });

  })
  .catch((error) => {

    console.log("MongoDB connection failed");
    console.log(error);

  });
server.js explanation
const express = require("express");

English: Imports Express.

Tamil: Backend server create செய்ய Express import.

const mongoose = require("mongoose");

English: Used to connect MongoDB.

Tamil: MongoDB connect செய்ய Mongoose.

const cors = require("cors");

English: Allows frontend and backend communication.

Tamil: Frontend localhost:5173 இருந்து backend localhost:5000 communicate செய்ய CORS தேவை.

const dotenv = require("dotenv");

English: Reads .env.

Tamil: .env உள்ள PORT/MONGO_URI values read செய்கிறது.

app.use(cors());

English: Enables CORS.

Tamil: Frontend → Backend request allow செய்கிறது.

app.use(express.json());

English: Reads JSON request body.

Tamil: Frontend அனுப்புற JSON data-ஐ req.body மூலம் பெற உதவும்.

app.use("/api/auth", authRoutes);

English: Connects authentication routes.

Tamil: authRoutes.js-ஐ /api/auth prefix-க்கு connect செய்கிறது.

So:

/register

becomes:

/api/auth/register

And:

/login

becomes:

/api/auth/login
