. Folder structure
backend
│
├── models
│   └── User.js
│
├── .env
├── server.js
└── package.json
2. Install
npm init -y
npm install express mongoose dotenv cors
3. .env
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/authDB

Easy meaning:

PORT → server port
MONGO_URI → MongoDB connection
4. models/User.js
const mongoose = require("mongoose");

const userSchema = new mongoose.Schema({
  name: String,
  email: String,
  password: String
});

module.exports = mongoose.model("User", userSchema);
இதுதான் Mongoose Model
Schema → எப்படி data இருக்கணும்
Model  → MongoDB-ல் data work பண்ண
5. server.js

இதை மட்டும் முதலில் practice பண்ணுங்க 👇

const express = require("express");
const mongoose = require("mongoose");
const cors = require("cors");
const dotenv = require("dotenv");

const User = require("./models/User");

dotenv.config();

const app = express();

app.use(cors());
app.use(express.json());


// MongoDB Connect
mongoose.connect(process.env.MONGO_URI)
  .then(() => console.log("MongoDB Connected"))
  .catch((err) => console.log(err));


// HOME
app.get("/", (req, res) => {
  res.send("Server is running");
});


// REGISTER - CREATE
app.post("/register", async (req, res) => {

  const user = await User.create(req.body);

  res.json({
    message: "Registration successful",
    user
  });
});


// LOGIN
app.post("/login", async (req, res) => {

  const user = await User.findOne({
    email: req.body.email,
    password: req.body.password
  });

  if (!user) {
    return res.json({
      message: "Invalid email or password"
    });
  }

  res.json({
    message: "Login successful",
    user
  });
});


// GET USERS - READ
app.get("/users", async (req, res) => {

  const users = await User.find();

  res.json(users);
});


// UPDATE
app.put("/users/:id", async (req, res) => {

  const user = await User.findByIdAndUpdate(
    req.params.id,
    req.body,
    { new: true }
  );

  res.json({
    message: "User updated",
    user
  });
});


// DELETE
app.delete("/users/:id", async (req, res) => {

  await User.findByIdAndDelete(req.params.id);

  res.json({
    message: "User deleted"
  });
});


// SERVER
app.listen(process.env.PORT, () => {
  console.log("Server running on port 5000");
});
6. இதை எப்படி நினைவில் வைக்கணும்?

ரொம்ப easy 👇

CREATE
app.post("/register", async (req, res) => {
  const user = await User.create(req.body);
  res.json(user);
});

POST → CREATE

READ
app.get("/users", async (req, res) => {
  const users = await User.find();
  res.json(users);
});

GET → READ

UPDATE
app.put("/users/:id", async (req, res) => {
  const user = await User.findByIdAndUpdate(
    req.params.id,
    req.body,
    { new: true }
  );

  res.json(user);
});

PUT → UPDATE

DELETE
app.delete("/users/:id", async (req, res) => {
  await User.findByIdAndDelete(req.params.id);

  res.json({
    message: "User deleted"
  });
});

DELETE → DELETE

7. Postman-la test பண்ணுங்க
Register

POST

http://localhost:5000/register

Body → raw → JSON:

{
  "name": "Barani",
  "email": "barani@gmail.com",
  "password": "123456"
}
Login

POST

http://localhost:5000/login
{
  "email": "barani@gmail.com",
  "password": "123456"
}
Get Users

GET

http://localhost:5000/users
Update

PUT

http://localhost:5000/users/USER_ID

Body:

{
  "name": "Barani Dharan"
}
Delete

DELETE

http://localhost:5000/users/USER_ID
🧠 One-line memory trick
POST    → User.create()
GET     → User.find()
PUT     → User.findByIdAndUpdate()
DELETE  → User.findByIdAndDelete()

இதுதான் உங்களுக்கு இப்போ MongoDB + Mongoose CRUD-க்கு முக்கியமான part.

Authentication-ல முதலில் இந்த simple login புரிஞ்சுக்கோங்க. Real project-ல password-ஐ plain text-ஆ store பண்ணக்கூடாது; அதற்கு அடுத்ததாக bcrypt add பண்ணலாம்.
