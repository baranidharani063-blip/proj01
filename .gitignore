Hi 👋 புரியுது. நீங்க கேட்குறது normal dashboard இல்லாமல், proper website home screen மாதிரி, மேலே Navbar + Toggle menu + navigation இருக்கணும். Monday test-ku easy-ah understand பண்ணுற மாதிரி வைத்துக்கலாம்.

இந்த example-la:

🏠 Home
ℹ️ About
📞 Contact
🌙 Light/Dark Toggle
📱 Mobile menu toggle
React useState
React Router navigation
1. Install React Router
npm install react-router-dom
2. App.jsx
import { useState } from "react";
import { BrowserRouter, Routes, Route, Link } from "react-router-dom";

function Home() {
  return (
    <div className="min-h-screen bg-gray-100">
      
      {/* Hero Section */}
      <div className="text-center py-20">
        <h1 className="text-4xl font-bold text-blue-600">
          Welcome to My Website 👋
        </h1>

        <p className="text-gray-600 mt-4">
          Simple React Website using Tailwind CSS
        </p>

        <button className="mt-6 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
          Get Started
        </button>
      </div>

      {/* Cards */}
      <div className="grid md:grid-cols-3 gap-6 px-8 pb-10">

        <div className="bg-white p-6 rounded-lg shadow text-center">
          <h2 className="text-xl font-bold">Easy</h2>
          <p className="text-gray-500 mt-2">
            Simple and easy to use
          </p>
        </div>

        <div className="bg-white p-6 rounded-lg shadow text-center">
          <h2 className="text-xl font-bold">Fast</h2>
          <p className="text-gray-500 mt-2">
            Fast React application
          </p>
        </div>

        <div className="bg-white p-6 rounded-lg shadow text-center">
          <h2 className="text-xl font-bold">Modern</h2>
          <p className="text-gray-500 mt-2">
            Modern website design
          </p>
        </div>

      </div>
    </div>
  );
}


function About() {
  return (
    <div className="p-10 text-center">
      <h1 className="text-3xl font-bold">About Us</h1>
      <p className="mt-4 text-gray-600">
        This is our simple React website.
      </p>
    </div>
  );
}


function Contact() {
  return (
    <div className="p-10 text-center">
      <h1 className="text-3xl font-bold">Contact Us</h1>
      <p className="mt-4 text-gray-600">
        Email: example@gmail.com
      </p>
    </div>
  );
}


function App() {

  const [darkMode, setDarkMode] = useState(false);
  const [menu, setMenu] = useState(false);

  return (
    <BrowserRouter>

      <div className={darkMode ? "bg-gray-900 min-h-screen text-white" : "bg-gray-100 min-h-screen"}>

        {/* Navbar */}
        <nav className="bg-blue-600 text-white px-6 py-4 flex justify-between items-center">

          <h1 className="text-2xl font-bold">
            MyWebsite
          </h1>

          {/* Desktop Menu */}
          <div className="hidden md:flex gap-6 items-center">

            <Link to="/" className="hover:text-gray-200">
              Home
            </Link>

            <Link to="/about" className="hover:text-gray-200">
              About
            </Link>

            <Link to="/contact" className="hover:text-gray-200">
              Contact
            </Link>

            {/* Dark Mode Toggle */}
            <button
              onClick={() => setDarkMode(!darkMode)}
              className="bg-white text-blue-600 px-3 py-1 rounded"
            >
              {darkMode ? "☀️" : "🌙"}
            </button>

          </div>

          {/* Mobile Toggle */}
          <button
            onClick={() => setMenu(!menu)}
            className="md:hidden text-2xl"
          >
            ☰
          </button>

        </nav>


        {/* Mobile Menu */}
        {menu && (
          <div className="md:hidden bg-blue-500 text-white p-5 space-y-4">

            <Link
              to="/"
              onClick={() => setMenu(false)}
              className="block"
            >
              Home
            </Link>

            <Link
              to="/about"
              onClick={() => setMenu(false)}
              className="block"
            >
              About
            </Link>

            <Link
              to="/contact"
              onClick={() => setMenu(false)}
              className="block"
            >
              Contact
            </Link>

          </div>
        )}


        {/* Pages */}
        <Routes>

          <Route path="/" element={<Home />} />

          <Route path="/about" element={<About />} />

          <Route path="/contact" element={<Contact />} />

        </Routes>

      </div>

    </BrowserRouter>
  );
}

export default App;
3. இது எப்படி work ஆகுது?
